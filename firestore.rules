rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /products/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /banners/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /coupons/{id} {
      allow read, write: if admin();
    }
    match /customers/{uid} {
      allow read, create, update: if owner(uid) || admin();
      allow delete: if admin();
      match /{document=**} { allow read, write: if owner(uid) || admin(); }
    }
    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /reviews/{reviewId} {
      allow read: if resource.data.status == "published" || admin();
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if admin();
    }
    match /returns/{returnId} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /settings/{id} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
