rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /invoices/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
